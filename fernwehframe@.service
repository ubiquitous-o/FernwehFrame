# ローカルサーバの常時起動（任意）。
# 通常のキオスクはautostart.shがGitHub Pagesを直接表示するため不要。
# オフライン検証やPagesを使わない構成のときだけ有効化する
[Unit]
Description=FernwehFrame - Live Camera Triptych Display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/fernwehframe
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
